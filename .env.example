# ============================================================
#  URL e identidade do site
# ============================================================
# URL base do site (usada em sitemap, robots e metadados)
NEXT_PUBLIC_SITE_URL=https://www.boavistaadvocacia.com.br

# Número do WhatsApp em formato internacional (somente dígitos)
NEXT_PUBLIC_WHATSAPP=5598982583769

# E-mail institucional que aparece no rodapé e recebe mensagens
NEXT_PUBLIC_CONTACT_EMAIL=bruno@boavistaadvocacia.com.br

# ============================================================
#  Envio do formulário de contato
#  Configure UM dos dois provedores abaixo.
#  Sem nenhum provedor, o formulário abre o WhatsApp com a
#  mensagem pronta para envio (modo fallback automático).
# ============================================================

# --- Opção A: Resend (https://resend.com) ---
# Gere uma chave em https://resend.com/api-keys
RESEND_API_KEY=
# Remetente deve ser um domínio verificado no Resend
CONTACT_FROM_EMAIL=site@boavistaadvocacia.com.br
# Destinatário das mensagens (padrão: NEXT_PUBLIC_CONTACT_EMAIL)
CONTACT_RECIPIENT_EMAIL=

# --- Opção B: SMTP (qualquer provedor, ex.: hospedagem do e-mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
